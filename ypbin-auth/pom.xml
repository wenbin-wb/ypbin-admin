<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-auth</artifactId>
    <name>${project.artifactId}</name>
    <description>ypbin-admin 微服务版：认证服务（登录/验证码/第三方登录）</description>

    <dependencies>
        <!-- 服务注册/配置中心 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <!-- 服务间调用 + 身份头透传 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <!-- 限流熔断 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <!-- 链路可观测 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <!-- 共享 Feign 接口 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <!-- 系统域共享（Feign 契约 + DTO）。
             排除 ypbin-starter-data：auth 无数据源，按 SKILL「auth/ai 不直连共享库」的约定，
             不得传递依赖 MyBatis-Plus；一旦有人在此模块引用实体类型，编译期就会因缺类而失败
             （这就是本排除项的强制作用，别再把它删掉）。 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>cn.ypbin</groupId>
                    <artifactId>ypbin-starter-data</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 安全：sa-token 登录态/密码加密/LoginHelper -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <!-- sa-token Redis 会话存储：与网关共享登录态（Jackson 3 序列化） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jackson3</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 验证码 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-captcha</artifactId>
        </dependency>
        <!-- 操作日志 / 幂等防重 / 限流 / 密码锁定 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <!-- 异步执行（@EnableAsync 自动装配 + 统一线程池）：登录日志经 /internal/log-ingest 上报 system，
             属阻塞式 RPC；不引入本模块时 LogEventListener 的 @Async 被静默忽略，Feign 调用会占用登录请求线程 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-async</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <!-- 缓存（验证码 Redis 存储） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cache</artifactId>
        </dependency>
        <!-- 埋点（登录/登出事件上报）：starter 的 TrackRecorder + 事件目录在 auth 侧生效，
             实际落库经 ypbin-common 的 RemoteTrackEventSink 上报 system（auth 无数据源）。
             注意：还须在 Nacos 的 ypbin-auth.yaml 打开 ypbin.tracking.enabled，否则只记一次 WARN 不采集。 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tracking</artifactId>
        </dependency>
        <!-- 短信（SmsUtils 发验证码） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-messaging</artifactId>
        </dependency>
        <!-- 第三方登录（JustAuth 封装） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-social</artifactId>
        </dependency>
        <!-- Web 请求工具（WebRequestUtils.ip 等） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL 驱动（Nacos 共享配置含 datasource，需能加载） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
