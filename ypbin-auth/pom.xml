<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-auth</artifactId>
    <name>${project.artifactId}</name>
    <description>ypbin-admin 微服务版：认证服务（登录/验证码/第三方登录）</description>

    <dependencies>
        <!-- 服务注册/配置中心 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <!-- 服务间调用 + 身份头透传 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <!-- 限流熔断 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <!-- 链路可观测 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <!-- 共享 Feign 接口 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <!-- 系统域共享（实体/Feign） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
        </dependency>
        <!-- 安全：sa-token 登录态/密码加密/LoginHelper -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <!-- 验证码 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-captcha</artifactId>
        </dependency>
        <!-- 操作日志 / 幂等防重 / 限流 / 密码锁定 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <!-- 缓存（验证码 Redis 存储） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cache</artifactId>
        </dependency>
        <!-- 短信（SmsUtils 发验证码） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-messaging</artifactId>
        </dependency>
        <!-- 第三方登录（JustAuth 封装） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-social</artifactId>
        </dependency>
        <!-- Web 请求工具（WebRequestUtils.ip 等） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL 驱动（Nacos 共享配置含 datasource，需能加载） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
