<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-admin-system</artifactId>
    <name>${project.artifactId}</name>
    <description>单体业务域：公共能力 + modules/{ai,auth,job,system}</description>

    <dependencies>
        <!-- 单体 Web 一站式基础能力（web/json/data/cache/security/api-doc/log/tools/async） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-app-web</artifactId>
        </dependency>
        <!-- 通用 CRUD 基类 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-crud</artifactId>
        </dependency>
        <!-- 多租户 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-tenant</artifactId>
        </dependency>
        <!-- 数据权限 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-datapermission</artifactId>
        </dependency>
        <!-- Excel 导入导出 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-excel</artifactId>
        </dependency>
        <!-- 行为验证码 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-captcha</artifactId>
        </dependency>
        <!-- 消息（短信/邮件） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-messaging</artifactId>
        </dependency>
        <!-- 文件存储 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-storage</artifactId>
        </dependency>
        <!-- 敏感词过滤 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-sensitive-words</artifactId>
        </dependency>
        <!-- 国际化 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-i18n</artifactId>
        </dependency>
        <!-- 接口加解密 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-api-crypto</artifactId>
        </dependency>
        <!-- 定时任务（自研，license 传递需要；业务调度已迁 XXL-JOB） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-job</artifactId>
        </dependency>
        <!-- XXL-JOB 执行器（分布式任务调度，替代自研 job 调度） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-xxljob</artifactId>
        </dependency>
        <!-- 接口签名 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-sign</artifactId>
        </dependency>
        <!-- 第三方登录 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-social</artifactId>
        </dependency>
        <!-- 商业授权（签发/管理台复用其 LicenseSigner 与国密能力） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-license</artifactId>
        </dependency>
        <!-- IP 归属地（离线库，实现 starter 的 IpLocationResolver 扩展点） -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ip2region</artifactId>
            <version>4.1.0</version>
        </dependency>
        <!-- AI 基座（ChatClient/RAG/Memory 封装，模型 starter 在 server 模块按需引入）-->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-ai</artifactId>
        </dependency>

        <!-- 短信服务：sms4j 聚合框架（厂商 jar 按实际需要引入 aliyun/tencent/huawei 等） -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-spring-boot-starter</artifactId>
        </dependency>
        <!-- URL/HTML 解析（URL/Sitemap 导入知识库文档） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <!-- RSS/Atom 解析（RSS 订阅导入） -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>
    </dependencies>
</project>
