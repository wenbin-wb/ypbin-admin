# 默认：文本文件统一用 LF，避免跨平台（Windows 开发 / Linux 构建）行尾差异造成的 diff 噪音
* text=auto eol=lf

# 源码与配置显式声明为 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.imports text eol=lf
*.factories text eol=lf

# Windows 专用脚本保持 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做行尾转换
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
