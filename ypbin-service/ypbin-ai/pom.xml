<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-ai</artifactId>
    <name>${project.artifactId}</name>
    <description>ypbin-admin 微服务版：AI 服务（知识库/对话/模型/统计）</description>

    <dependencies>
        <!-- 服务注册/配置中心 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <!-- 服务间调用 + 身份头透传 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <!-- 限流熔断 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <!-- 链路可观测 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <!-- 共享 Feign 接口 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <!-- 系统域共享实体/枚举（SysUser 等） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
        </dependency>
        <!-- AI 域共享（entity/model） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai-api</artifactId>
        </dependency>
        <!-- AI 运行时 + 数据访问 + 安全/日志/工具 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <!-- SSE 流式桥接（SseStreamBridge：Flux → SseEmitter 的错误帧/订阅释放/上下文传播）。
             仅该类需要本依赖，不会启用 SSE 订阅端点与 Redis 扇出（那需要 ypbin.sse.enabled=true，
             ai 的 Nacos 配置里刻意没有该键，走默认 false）。 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-messaging</artifactId>
        </dependency>
        <!-- 异步执行（@EnableAsync 自动装配 + 统一线程池）：本服务的 @Log 经 /internal/log-ingest 上报 system，
             且 AiDocumentVectorizer.vectorizeAsync 早已标了 @Async（此前无本依赖被静默忽略、实为同步向量化） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-async</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RSS/Sitemap 导入（AI 知识库） -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>
        <!-- Boot 4.1 出站地址过滤：InetAddressFilter 用于用户提交 URL 的 SSRF 防护 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-http-client</artifactId>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 配置元数据生成器（编译期注解处理器，optional ⇒ 不进运行期类路径）：
             让 @ConfigurationProperties(AiModelConfigProperties) 生成
             META-INF/spring-configuration-metadata.json，使 ypbin.ai.model-config.* 在 IDE/配置中心
             有补全与文档、并能在配置写错键时被发现（starter #103 的「强类型化」收益之一）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL 驱动（运行时） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Reactor 跨线程租户传播（tenant 的 ThreadLocalAccessor，optional 不传递需显式引入） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
