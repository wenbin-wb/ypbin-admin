<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-ai</artifactId>
    <name>${project.artifactId}</name>
    <description>ypbin-admin 微服务版：AI 服务（知识库/对话/模型/统计）</description>

    <dependencies>
        <!-- 服务注册/配置中心 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <!-- 服务间调用 + 身份头透传 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <!-- 限流熔断 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <!-- 链路可观测 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <!-- 共享 Feign 接口 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <!-- 系统域共享（实体/Feign） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
        </dependency>
        <!-- AI 域共享（entity/model） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai-api</artifactId>
        </dependency>
        <!-- AI 运行时 + 数据访问 + 安全/日志/工具 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RSS/Sitemap 导入（AI 知识库） -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
