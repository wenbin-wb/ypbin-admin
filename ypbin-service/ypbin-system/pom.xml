<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-system</artifactId>
    <name>${project.artifactId}</name>
    <description>ypbin-admin 微服务版：系统管理服务（用户/角色/菜单/部门/岗位等核心管理域）</description>

    <dependencies>
        <!-- 服务注册/配置中心 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <!-- 服务间调用 + 身份头透传 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <!-- 限流熔断 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <!-- 链路可观测 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <!-- 共享 Feign 接口与身份头上下文 -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <!-- 系统域共享（实体/Feign） -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
        </dependency>
        <!-- @CacheEvict 声明式缓存失效（system 侧写操作清跨服务缓存） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cache</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-datapermission</artifactId>
        </dependency>

        <!-- 操作日志 / 幂等防重 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <!-- 安全/Excel/存储/敏感词/Web -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-job</artifactId>
        </dependency>
        <!-- 授权签发（LicenseSigner/Sm2Utils/Sm4Utils） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-license</artifactId>
        </dependency>
        <!-- 公告投递通道（邮件/推送/短信） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-messaging</artifactId>
        </dependency>
        <!-- 短信聚合框架 sms4j（公告短信通道 / 短信配置动态注册） -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-spring-boot-starter</artifactId>
        </dependency>
        <!-- 接口签名（开放 API 示例 / 联机授权校验） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-sign</artifactId>
        </dependency>
        <!-- 第三方登录配置管理（平台授权请求注册表） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-social</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-sensitive-words</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>

        <!-- Web / 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL 驱动（运行时） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
