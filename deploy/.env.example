# MySQL root 密码(必改)
MYSQL_ROOT_PASSWORD=change-me

# 初始管理员账号(首次 Bootstrap 创建)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# 端口(可选;被占用时改这里再重跑)
ADMIN_PORT=8080
ADMIN_UI_PORT=18080

# CORS(默认关闭,同源访问无需开启;跨域访问时改成 true 并配 YPBIN_CORS_ORIGINS)
YPBIN_CORS_ENABLED=false
# CORS 允许的来源(逗号分隔;开启时改成你的访问域名/服务器IP)
# 例如: http://localhost:*,https://admin.你的域名.com,http://43.242.200.8:*
YPBIN_CORS_ORIGINS=http://localhost:*

