# ============================================================
# ypbin-admin 微服务版 compose 环境变量模板
# 用法：复制为 deploy/.env 后执行：
#   cp deploy/.env.example deploy/.env
#   docker compose -f docker-compose.yml up -d
#
# 说明：应用运行参数（DB/Redis/路由/租户/白名单等）已全部下沉 Nacos，
#       这里只保留 Docker compose 基础设施必需项与前端部署目录。
# ============================================================

# MySQL root 密码（Nacos 中 ypbin-common.yaml 的 spring.datasource.password 必须与此一致）
# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MYSQL_ROOT_PASSWORD

# ============================================================
# Nacos / Redis 凭据（deploy/docker-compose.yml 强制从 .env 读取，缺失时启动即报错）
# 正式部署请用 deploy/install.sh —— 它会随机生成以下键并写入 .env；
# 此处仅为本仓库快速起 compose 的占位示例，不含任何真实凭据，请勿在生产沿用示例值。
# ============================================================

# Nacos 服务端鉴权 token（对应容器环境变量 NACOS_AUTH_TOKEN；须为 Base64 且解码后 ≥32 字节）
# 生成：openssl rand -base64 48
NACOS_AUTH_TOKEN=REPLACE_WITH_RANDOM_BASE64_48_BYTES

# Nacos 服务端身份标识键/值（对应 NACOS_AUTH_IDENTITY_KEY / NACOS_AUTH_IDENTITY_VALUE，
# 与上面 token 配套，由 Nacos 服务端使用）
# 生成：openssl rand -hex 32
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=REPLACE_WITH_RANDOM_HEX_32_BYTES

# Redis 访问密码（compose 内建 Redis 以 --requirepass 启用；必须与 Nacos 共享配置
# ypbin-common.yaml 的 spring.data.redis.password 一致。NO_DOCKER 用外部无认证 Redis 时可留空）
# 生成：openssl rand -hex 16
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

# 内部 Feign 调用凭证（服务间经 Feign 直连 /internal/** 时携带 X-Internal-Token，system 守卫
# 校验；auth/system/ai 须共享一致值，走 Nacos 共享配置 ypbin.internal.token）。install.sh 部署时
# 随机生成 64 位 hex 写入 .env 并替换进 Nacos；此处仅为占位示例，请勿在生产沿用。
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN

# 网关身份头签名标记（防伪造：网关签发 X-Gateway-Signed，下游校验后才信任 X-User-Id 等身份头）。
# install.sh 部署时随机生成并写入 .env、替换进 Nacos；网关与 auth/system/ai 必须共享同一值。
# 留空则下游不校验来源（向后兼容），生产建议保持随机值启用。
GATEWAY_SIGN_TOKEN=REPLACE_WITH_RANDOM_GATEWAY_SIGN_TOKEN

# AI 模型 API Key 加密密钥（16/24/32 字节）。
# install.sh 首次全新部署未显式提供时自动随机生成并写入 .env（请妥善保存）；复用旧 .env 时必须沿用旧值，
# 未配置且非全新部署时 install.sh 直接终止、AI 服务拒绝启动。
# 用于加解密库内已存的模型密钥，**必须长期保持不变**——换新值后旧密文无法解密。
# 手工生成：openssl rand -hex 16（32 字节；该值按原始字节当 AES 密钥用，不做 base64 解码，
# 故不能用 openssl rand -base64 32——那是 44 字节，会被长度校验拒绝）
AI_MODEL_SECRET_KEY=REPLACE_WITH_STABLE_AI_MODEL_SECRET_KEY

# 前端容器映射端口（默认 19000，避免与网关 18080 冲突）
ADMIN_UI_PORT=19000

# 前端静态文件目录（install.sh 构建产物位置）
ADMIN_UI_DIST_DIR=/opt/ypbin/main/ypbin-admin/admin-ui-dist

# Docker 镜像前缀（需要加速源时填写，如 docker.m.daocloud.io/）。
# 留空=机器默认：直接用 Docker 守护进程配置的 registry-mirrors，无配置才走官方 Docker Hub；
# install.sh 不做任何镜像源探测/遍历。在此填写或 export REGISTRY_PREFIX=<前缀>/ 即按该前缀拉取，
# 作用于基础设施（nacos/redis/mysql）与 xxl-job/nginx 镜像；尾斜杠缺失时会自动补齐。
REGISTRY_PREFIX=

# 内部端口绑定地址（mysql/redis/nacos/xxl-job 与 18081-18083 这些"只应内网访问"的端口）。
# 默认 0.0.0.0（与既有行为一致；redis 默认仍是 127.0.0.1）。生产建议收窄为 127.0.0.1，
# 只对外暴露前端（19000）与网关（18080）：
#   INTERNAL_BIND_ADDR=127.0.0.1
INTERNAL_BIND_ADDR=0.0.0.0
