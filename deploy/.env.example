# ============================================================
# ypbin-admin Docker 部署环境变量（全量，含可用默认值）
# 用法：复制为 deploy/.env 即可直接启动：
#   cp deploy/.env.example deploy/.env
# 说明：所有键均已填好默认值，正式部署可直接使用；
#       生产环境建议修改敏感项（密码/密钥）后再启动。
# ============================================================

# ---------- MySQL（docker-compose 内建容器）----------
# MySQL root 密码（同时作为 admin 容器的 DB 密码）。必填：install.sh 会自动随机生成；
# 手工复制本文件时必须填写，compose 的 :? 会拒绝空值（不再内置可猜的默认口令）。
MYSQL_ROOT_PASSWORD=
# MySQL 宿主机映射端口（默认 3307，避开本机常占的 3306；容器内仍为 3306）
MYSQL_PORT=3307
# 内部端口绑定地址：mysql/redis/admin 默认只绑回环，只对外暴露前端（18080）。
# 多机部署需要宿主机外访问时改为 0.0.0.0，并配合防火墙收敛来源。
INTERNAL_BIND_ADDR=127.0.0.1

# ---------- Redis（docker-compose 内建容器）----------
# Redis 宿主机映射端口（默认 6380，避开常见 6379；容器内仍为 6379）
REDIS_PORT=6380

# ---------- 初始管理员账号（首次 Bootstrap 创建）----------
ADMIN_BOOTSTRAP_USERNAME=admin
# 初始管理员密码：留空即可（Bootstrap 默认关闭）；启用 Bootstrap 时必须填写强口令，
# 否则启动失败。install.sh 生成 .env 时会自动随机化。
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 端口（被占用时改这里再重跑）----------
# 后端容器映射端口
ADMIN_PORT=8080
# 前端容器映射端口
ADMIN_UI_PORT=18080

# ---------- XXL-JOB 任务调度（默认关闭，业务任务迁 XXL-JOB 调度中心）----------
# 启用执行器注册（需先部署 xxl-job-admin 调度中心）
YPBIN_XXL_JOB_ENABLED=false
# 调度中心地址（3.4.x context path 为根路径；跨 compose 部署时用宿主机可达地址）
YPBIN_XXL_JOB_ADMIN=http://host.docker.internal:18085

# ---------- 接口加解密 ----------
# AES 密钥（UTF-8 编码后 16/24/32 字节，与消费端一致）。install.sh 生成 .env 时会随机化；
# 手工部署必须自行生成并填写（compose 会做非空校验）。未提供时应用仍可启动，
# 只是不装配加解密 Provider（对应能力关闭）。
API_CRYPTO_KEY=

# ---------- AI 模块 ----------
# AI 模型 API Key 加密密钥（16/24/32 字节；必填，未配置则 AI 模块拒绝启动）。
# 不提供内置默认值：install.sh 生成 .env 时会随机化，手工部署请自行生成并长期保存。
AI_MODEL_SECRET_KEY=
# AI 向量持久化文件路径（容器内路径；挂载 admin-data 卷持久化）
AI_SIMPLE_STORE_PATH=data/ai/simple-vector-store.json

# ---------- License 签发密钥（留空启动 OK，签发前必须填）----------
# 获取：启动后调 POST /system/license/generate-key 或前端「生成密钥」，填入下面三项后重启
LICENSE_ISSUER_PUBLIC_KEY=
LICENSE_ISSUER_PRIVATE_KEY=
LICENSE_ISSUER_SM4_KEY=

# ---------- CORS（默认关闭，同源访问无需开启）----------
# 跨域访问时改成 true 并配 YPBIN_CORS_ORIGINS
YPBIN_CORS_ENABLED=false
# CORS 允许的来源（逗号分隔；开启时改成你的访问域名/服务器 IP）
# 例如: http://localhost:*,https://admin.你的域名.com,http://43.242.200.8:*
YPBIN_CORS_ORIGINS=http://localhost:*
