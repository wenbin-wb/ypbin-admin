# ============================================================
# ypbin-admin Docker 部署环境变量模板（全量）
# 用法：复制为 deploy/.env 并填入真实值；docker compose 启动时自动加载。
# 说明：带默认值的项可留空使用默认；敏感项（密码/密钥）必须显式设置。
# ============================================================

# ---------- MySQL（docker-compose 内建容器）----------
# MySQL root 密码（必改；同时作为 admin 容器的 DB 密码）
MYSQL_ROOT_PASSWORD=change-me
# MySQL 宿主机映射端口（可选；默认 3306）
MYSQL_PORT=3306

# ---------- Redis（docker-compose 内建容器）----------
# Redis 宿主机映射端口（可选；默认 6379）
REDIS_PORT=6379

# ---------- 初始管理员账号（首次 Bootstrap 创建）----------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---------- 端口（可选；被占用时改这里再重跑）----------
# 后端容器映射端口（默认 8080）
ADMIN_PORT=8080
# 前端容器映射端口（默认 18080）
ADMIN_UI_PORT=18080

# ---------- 任务调度 ----------
# 通知投递对账延迟（毫秒，默认 30000）
ADMIN_JOB_RECONCILE_DELAY=30000

# ---------- 接口加解密 ----------
# AES 密钥（16/24/32 字节，与消费端一致；留空则不启用）
API_CRYPTO_KEY=

# ---------- AI 模块 ----------
# AI 模型 API Key 加密密钥（16/24/32 字节；必填，未配置则 AI 模块拒绝启动）
AI_MODEL_SECRET_KEY=change-me-32-bytes-key!!!!
# AI 向量持久化文件路径（容器内路径；挂载 admin-data 卷持久化）
AI_SIMPLE_STORE_PATH=data/ai/simple-vector-store.json

# ---------- License 签发密钥（留空启动 OK，签发前必须填）----------
# 获取：启动后调 POST /system/license/generate-key 或前端「生成密钥」，填入下面三项后重启
LICENSE_ISSUER_PUBLIC_KEY=
LICENSE_ISSUER_PRIVATE_KEY=
LICENSE_ISSUER_SM4_KEY=

# ---------- CORS（默认关闭，同源访问无需开启）----------
# 跨域访问时改成 true 并配 YPBIN_CORS_ORIGINS
YPBIN_CORS_ENABLED=false
# CORS 允许的来源（逗号分隔；开启时改成你的访问域名/服务器 IP）
# 例如: http://localhost:*,https://admin.你的域名.com,http://43.242.200.8:*
YPBIN_CORS_ORIGINS=http://localhost:*
