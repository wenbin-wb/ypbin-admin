<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-architecture-tests</artifactId>
    <name>${project.artifactId}</name>
    <description>架构约束测试：把 admin 铁律变为构建失败（禁内联全限定类名/禁 Collections.emptyXxx/禁 @Data/禁 Enum.ordinal/禁循环内 DB-RPC/实体继承例外清单显式）</description>

    <properties>
        <!-- 纯测试模块：不发布、不打进任何服务的产物，也不该出现在别人的依赖树里 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- 与 ypbin-starter-architecture-tests 同版本（starter 侧由 ypbin-starter-dependencies 管理，
             本仓不复用 starter 的 dependencies pom，故在此显式钉住，避免两仓规则库行为分叉） -->
        <archunit.version>1.5.0</archunit.version>
    </properties>

    <dependencies>
        <!--
          分析对象：admin 各模块的主源码与字节码，故以 test 作用域聚合（不污染任何其它模块）。
          这 7 个依赖正是本门禁的分析目标，**不得删除**：删掉任何一个，该模块的类就退出分析范围。
          ⚠️ 但「是被分析对象」不等于「从测试类路径导入」：本仓 4 个模块（ypbin-system / ypbin-ai /
          ypbin-gateway / ypbin-auth）的 spring-boot-maven-plugin:repackage 未配 classifier，主构件是
          BOOT-INF/classes 布局的 fat jar，
          于是**带 package 阶段的全反应堆构建**（`mvn -B clean verify`，即 CI 路径）里测试类路径拿到的是该
          jar——实测 `cn.ypbin.admin` 只解析到 167 个类、`..service.impl..` **0 个**（ArchUnit 因
          failOnEmptyShould 报 failed to check any classes），而只跑到 `test` 时又是 392 个 ⇒ 门禁结果依赖
          打包形态。故 CodingRulesTest 已改为**按本仓模块目录显式 import 各 `target/classes`**
          （见其 importClasses 注释），不再问 Maven 要的是 jar 还是目录。
          代价：构建本模块前兄弟模块必须已编译（`-am` 或全反应堆）；任一模块缺 target/classes 时显式失败，
          不会退化成缩水导入。
        -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-auth</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-gateway</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit：字节码级架构断言（版本与 starter 侧一致） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5 + AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
