# ============================================================
# ypbin-admin 环境变量模板（全量）
# 用法：复制为 .env 并填入真实值；.env 不提交（已在 .gitignore 忽略）。
# 启动前加载这些环境变量（IDE 运行配置注入，或 shell export）。
# 说明：所有变量均带默认值（见 application.yml 的 ${VAR:default}），
#       留空即使用默认值；敏感项（密码/密钥）必须显式设置。
# ============================================================

# ---------- MySQL ----------
# 数据库地址（默认 localhost）
DB_HOST=127.0.0.1
# 数据库端口（默认 3306）
DB_PORT=3306
# 数据库名（默认 ypbin_admin；Flyway 会自动建表）
DB_NAME=ypbin_admin
# 数据库用户（默认 root；生产建议最小权限账号）
DB_USER=root
# 数据库密码（必填；生产禁止空密码）
DB_PASSWORD=

# ---------- Redis ----------
# Redis 地址（默认 localhost）
REDIS_HOST=127.0.0.1
# Redis 端口（默认 6379）
REDIS_PORT=6379
# Redis 库号（默认 0）
REDIS_DB=0
# Redis 密码（无密码留空）
REDIS_PASSWORD=

# ---------- 管理员 Bootstrap（首次启动初始化）----------
# 是否启用 Bootstrap 初始化（true=首次启动时用下面账号创建平台管理员；默认 false）
ADMIN_BOOTSTRAP_ENABLED=false
# 初始管理员用户名
ADMIN_BOOTSTRAP_USERNAME=admin
# 初始管理员密码（必填：ADMIN_BOOTSTRAP_ENABLED=true 时必须设置）
ADMIN_BOOTSTRAP_PASSWORD=
# 初始管理员真实姓名（默认 平台管理员）
ADMIN_BOOTSTRAP_REAL_NAME=平台管理员
# 初始管理员归属租户 ID（默认 1）
ADMIN_BOOTSTRAP_TENANT_ID=1

# ---------- 任务调度 ----------
# 通知投递对账延迟（毫秒，默认 30000）：启动后延迟多久执行一次投递对账
ADMIN_JOB_RECONCILE_DELAY=30000

# ---------- 接口加解密（ypbin.api-crypto）----------
# AES 密钥（16/24/32 字节，需与消费端一致；留空则不装配默认加解密器，
# 仅当接口标注 @ApiEncrypt/@ApiDecrypt 且本密钥已配置时才生效）
API_CRYPTO_KEY=

# ---------- AI 模块（ypbin.ai）----------
# AI 模型 API Key 加密密钥（16/24/32 字节；**必填**，未配置则 AI 模块拒绝启动，
# 用于对 ai_model_config 表中的模型 API Key 做 AES-GCM 加密存储）
AI_MODEL_SECRET_KEY=
# AI 向量持久化文件路径（SimpleVectorStore 重启不丢；默认 data/ai/simple-vector-store.json）
AI_SIMPLE_STORE_PATH=data/ai/simple-vector-store.json

# ---------- License 签发密钥（ypbin.license.issuer）----------
# 签发端密钥（不提交真实值；留空启动 OK，执行签发前必须填）
# 获取：启动后调 POST /system/license/generate-key 或前端授权管理页「生成密钥」，
# 一次性返回 publicKey/privateKey/sm4Key（不落库），填入下面三项后重启即可签发。
# 签发端持有全部三项（SM2 公钥/私钥 + SM4 密钥）；消费端只需 PUBLIC_KEY + SM4_KEY。
# 私钥仅签发端持有，切勿外泄或提交。
LICENSE_ISSUER_PUBLIC_KEY=
LICENSE_ISSUER_PRIVATE_KEY=
LICENSE_ISSUER_SM4_KEY=

# ============================================================
# 可选：直接配置模型 Starter（二选一，替代「AI 配置」页动态模型）
# 默认推荐使用「AI 配置」页管理模型（模型地址/密钥/型号后台配置），无需在此配置。
# 以下为 yml 注释中预留的直连方案，按需启用（同时需在 application.yml 解注释对应段）：
# ---------- DeepSeek（推荐，国内低成本）----------
# DEEPSEEK_API_KEY=
# ---------- OpenAI ----------
# OPENAI_API_KEY=
# ============================================================
