# ypbin-admin 环境变量模板
# 用法：复制为 .env 并填入真实值；.env 不提交（已在 .gitignore 忽略）。
# 启动前加载这些环境变量（IDE 运行配置注入，或 shell export）。
# application.yml 已内置本地默认值（localhost/root123456），本地开发可不设这些变量直接跑。

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ypbin_admin
DB_USER=root
DB_PASSWORD=root123456

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
